do
-- elements: Label, Progress, Console, ButtonRow, Stats + Window:Dialog / AddSettingsTab / helpers

local Create, themed, safeTween, Element, Tab, Window = I.Create, I.themed, I.safeTween, I.Element, I.Tab, I.Window
local Kit = Polaris.Kit
local svc = Polaris.Util.svc

local function newClass()
	local C = setmetatable({}, { __index = Element })
	C.__index = C
	return C
end

-- Shared scaffold: an element whose container is a plain Frame of a given height.
local function scaffold(Class, window, tab, config, className, height)
	local self = Element._new(window, tab, config, className)
	setmetatable(self, Class)
	local row = Create("Frame", {
		Name = className,
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		Parent = tab._content,
	})
	self._container = row
	tab:_updateCanvas()
	return self, row
end

local function setHeight(self, h)
	if self._container then
		self._container.Size = UDim2.new(1, 0, 0, h)
		self._tab:_updateCanvas()
	end
end
Polaris._setHeight = setHeight

-- Make a container fill the visible page height (re-measured when the window resizes).
local function bindFill(self, minHeight, margin)
	local page = self._tab._content
	local function apply()
		local h = page.AbsoluteSize and page.AbsoluteSize.Y or 0
		if h and h > 0 and self._container then
			setHeight(self, math.max(minHeight, h - (margin or 8)))
		end
	end
	apply()
	self:_track(page:GetPropertyChangedSignal("AbsoluteSize"):Connect(apply))
end
Polaris._bindFill = bindFill
Polaris._scaffold = scaffold
Polaris._newClass = newClass

----------------------------------------------------------------
-- Label: headings, notes, status lines (supports RichText)
----------------------------------------------------------------

local Label = newClass()

function Label:_create(window, tab, config)
	local self, row = scaffold(Label, window, tab, config, "Label", 24)
	local size = config.Size or 14
	local text = Kit.label(row, config.Text or config.Name or "", {
		Size = size,
		Color = config.Color or "Text",
		Bold = config.Bold,
		Align = config.Align or "Left",
		Wrap = true,
		Rich = config.Rich == true,
		Auto = true,
		Height = size + 8,
		Width = 1,
		WidthOffset = -16,
		Position = UDim2.new(0, 8, 0, 0),
	})
	self._text = text
	self._value = tostring(config.Text or config.Name or "")
	self:_sync()
	self:_track(text:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_sync(true)
	end))
	return self
end

function Label:_sync(measured)
	local size = self._config.Size or 14
	local h
	if measured and self._text.AbsoluteSize and self._text.AbsoluteSize.Y > 0 then
		h = self._text.AbsoluteSize.Y + 6
	else
		local perLine = math.max(8, math.floor(460 / (size * 0.62)))
		local lines = math.max(1, math.ceil(#self._value / perLine))
		h = lines * (size + 4) + 6
	end
	if self._container and math.abs(self._container.Size.Y.Offset - h) > 1 then
		setHeight(self, h)
	end
end

function Label:_setValue(v)
	self._value = tostring(v)
	if self._text then
		self._text.Text = self._value
		self:_sync()
	end
end

function Label:SetText(t)
	self:Set(t, true)
end

function Label:SetColor(color)
	if self._text then
		Kit.paint(self._text, "TextColor3", color)
	end
end

function Tab:CreateLabel(config)
	if type(config) == "string" then
		config = { Text = config }
	end
	return Label:_create(self._window, self, config)
end

-- Convenience: big heading
function Tab:CreateHeading(text, size)
	return self:CreateLabel({ Text = text, Size = size or 22, Bold = true })
end

----------------------------------------------------------------
-- Progress bar
----------------------------------------------------------------

local Progress = newClass()

function Progress:_create(window, tab, config)
	local self, row = scaffold(Progress, window, tab, config, "Progress", 44)
	self._max = config.Max or 1
	self._name = tostring(config.Name or "Progress")
	self._label = nil -- progress bars are not part of search filtering
	local title = Kit.label(row, self._name, { Size = 14, Position = UDim2.new(0, 8, 0, 2), WidthOffset = -90, Width = 1 })
	self._title = title
	self._pct = Kit.label(row, "0%", { Size = 13, Color = "SubText", Align = "Right", Width = 0, WidthOffset = 70, Position = UDim2.new(1, -78, 0, 2) })
	local track = Kit.frame(row, { Color = "Secondary", Radius = 4, Size = UDim2.new(1, -16, 0, 10), Position = UDim2.new(0, 8, 0, 28), Stroke = true })
	local fill = Kit.frame(track, { Color = config.Color or "Accent", Radius = 4, Size = UDim2.new(0, 0, 1, 0) })
	self._fill = fill
	self._value = 0
	self:_setValue(config.Value or config.Default or 0)
	return self
end

function Progress:_setValue(v)
	v = tonumber(v) or 0
	local frac = math.clamp(v / self._max, 0, 1)
	self._value = v
	if self._fill then
		safeTween(self._fill, 0.2, { Size = UDim2.new(frac, 0, 1, 0) })
		self._pct.Text = tostring(math.floor(frac * 100 + 0.5)) .. "%"
	end
end

function Progress:SetText(t)
	if self._title then
		self._title.Text = tostring(t)
	end
end

function Tab:CreateProgress(config)
	if type(config) == "string" then
		config = { Name = config }
	end
	return Progress:_create(self._window, self, config or {})
end

----------------------------------------------------------------
-- Console: scrolling log (great for script output and research logs)
----------------------------------------------------------------

local Console = newClass()
local LOG_COLORS = { info = "Text", ok = "Success", warn = "Warning", error = "Danger", dim = "SubText" }

function Console:_create(window, tab, config)
	local height = config.Height or 150
	local self, row = scaffold(Console, window, tab, config, "Console", height + (config.Name and 22 or 0))
	self._max = config.MaxLines or 200
	self._lines = {}
	local top = 0
	if config.Name then
		Kit.label(row, config.Name, { Size = 14, Position = UDim2.new(0, 8, 0, 0), WidthOffset = -16, Height = 20 })
		top = 22
	end
	local box = Kit.frame(row, { Color = "Secondary", Radius = 6, Stroke = true, Size = UDim2.new(1, -16, 0, height), Position = UDim2.new(0, 8, 0, top) })
	local scroll = Kit.scroll(box, { Padding = 2, Size = UDim2.new(1, -12, 1, -12), Position = UDim2.new(0, 6, 0, 6) })
	self._scroll = scroll
	self._order = 0
	self._value = ""
	return self
end

function Console:Log(text, kind)
	if self._destroyed then
		return
	end
	self._order += 1
	local line = Kit.label(self._scroll, tostring(text), {
		Size = 13, Color = LOG_COLORS[kind or "info"] or "Text", Wrap = true, Auto = true, Height = 16, Name = "Line",
	})
	line.LayoutOrder = self._order
	table.insert(self._lines, line)
	while #self._lines > self._max do
		local old = table.remove(self._lines, 1)
		old:Destroy()
	end
	self._value = (self._value ~= "" and (self._value .. "\n") or "") .. tostring(text)
	pcall(function()
		self._scroll.CanvasPosition = Vector2.new(0, 1e6)
	end)
	return line
end

function Console:Clear()
	for _, l in self._lines do
		l:Destroy()
	end
	self._lines = {}
	self._value = ""
end

function Console:_setValue(v)
	self:Clear()
	if v and v ~= "" then
		self:Log(v)
	end
end

function Tab:CreateConsole(config)
	return Console:_create(self._window, self, config or {})
end

----------------------------------------------------------------
-- ButtonRow: several buttons side by side
----------------------------------------------------------------

local ButtonRow = newClass()

function ButtonRow:_create(window, tab, config)
	assert(type(config.Buttons) == "table" and #config.Buttons > 0, "[Polaris] ButtonRow: Buttons must be a non-empty list")
	local self, row = scaffold(ButtonRow, window, tab, config, "ButtonRow", config.Height or 36)
	self._buttons = {}
	local n = #config.Buttons
	local gap = 6
	row = Create("Frame", { Name = "Holder", Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, Parent = row })
	for i, def in ipairs(config.Buttons) do
		local name = def.Name or def[1] or ("Button " .. i)
		local cb = def.Callback or def[2]
		local btn = Kit.button(row, name, {
			Color = def.Color or (i == 1 and "Accent" or "Secondary"),
			TextColor = (i ~= 1 and not def.Color) and "Text" or nil,
			Size = UDim2.new(1 / n, i == n and 0 or -gap, 0, (config.Height or 36) - 4),
			Position = UDim2.new((i - 1) / n, 0, 0, 2),
			TextSize = 13,
		})
		self:_track(btn.Activated:Connect(function()
			if self._disabled then
				return
			end
			I.invokeCallback(cb)
		end))
		table.insert(self._buttons, btn)
	end
	self._value = true
	return self
end

function ButtonRow:_setValue() end

function Tab:CreateButtonRow(config)
	return ButtonRow:_create(self._window, self, config or {})
end

----------------------------------------------------------------
-- Stats: live readout tiles (FPS, ping, players, memory, or your own)
----------------------------------------------------------------

local Stats = newClass()
Polaris.StatsProviders = {}

local function fpsMeter()
	local m = { frames = 0, t = os.clock(), value = 0 }
	local conn
	local ok = pcall(function()
		conn = I.services.RunService.Heartbeat:Connect(function()
			m.frames += 1
			local now = os.clock()
			if now - m.t >= 1 then
				m.value = m.frames / (now - m.t)
				m.frames = 0
				m.t = now
			end
		end)
	end)
	function m:Get()
		return tostring(math.floor(self.value + 0.5))
	end
	function m:Destroy()
		if conn then
			conn:Disconnect()
		end
	end
	if not ok then
		function m:Get()
			return "-"
		end
	end
	return m
end

local BUILTIN = {
	FPS = function(ctx)
		ctx.fps = ctx.fps or fpsMeter()
		return function()
			return ctx.fps:Get()
		end
	end,
	Ping = function()
		return function()
			local ok, v = pcall(function()
				return svc("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
			end)
			return ok and (tostring(math.floor(v + 0.5)) .. " ms") or "-"
		end
	end,
	Players = function()
		return function()
			local ok, v = pcall(function()
				return #I.services.Players:GetPlayers() .. "/" .. I.services.Players.MaxPlayers
			end)
			return ok and v or "-"
		end
	end,
	Memory = function()
		return function()
			local ok, v = pcall(function()
				return svc("Stats"):GetTotalMemoryUsageMb()
			end)
			return ok and (tostring(math.floor(v)) .. " MB") or "-"
		end
	end,
	Time = function()
		return function()
			return os.date("%H:%M:%S")
		end
	end,
	Server = function()
		return function()
			local ok, v = pcall(function()
				return game.JobId ~= "" and game.JobId:sub(1, 8) or "studio"
			end)
			return ok and v or "-"
		end
	end,
}
Polaris.StatsProviders = BUILTIN

function Stats:_create(window, tab, config)
	local items = config.Items or { "FPS", "Ping", "Players", "Memory" }
	local cols = config.Columns or math.min(#items, 4)
	local rows = math.ceil(#items / cols)
	local tileH = 54
	local self, row = scaffold(Stats, window, tab, config, "Stats", rows * (tileH + 6))
	row = Create("Frame", { Name = "Holder", Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, Parent = row })
	self._ctx = {}
	self._getters = {}
	self._valueLabels = {}
	for i, item in ipairs(items) do
		local name, getter
		if type(item) == "string" then
			name = item
			getter = BUILTIN[item] and BUILTIN[item](self._ctx) or function()
				return "?"
			end
		else
			name = item.Name or item[1] or ("Stat " .. i)
			local g = item.Get or item[2]
			getter = type(g) == "function" and g or function()
				return tostring(g)
			end
		end
		local c = (i - 1) % cols
		local r = math.floor((i - 1) / cols)
		local tile = Kit.frame(row, {
			Color = "Secondary", Radius = 8, Stroke = true,
			Size = UDim2.new(1 / cols, c == cols - 1 and 0 or -6, 0, tileH),
			Position = UDim2.new(c / cols, 0, 0, r * (tileH + 6)),
		})
		Kit.label(tile, string.upper(name), { Size = 11, Color = "SubText", Position = UDim2.new(0, 10, 0, 6), WidthOffset = -20, Height = 14 })
		local val = Kit.label(tile, "-", { Size = 20, Bold = true, Position = UDim2.new(0, 10, 0, 22), WidthOffset = -20, Height = 26 })
		table.insert(self._getters, getter)
		table.insert(self._valueLabels, val)
	end
	self._value = ""
	self:Refresh()
	local interval = config.Interval or 1
	task.spawn(function()
		while not self._destroyed do
			task.wait(interval)
			if self._destroyed then
				break
			end
			self:Refresh()
		end
	end)
	return self
end

function Stats:Refresh()
	for i, getter in ipairs(self._getters) do
		local ok, v = pcall(getter)
		local lbl = self._valueLabels[i]
		if lbl and lbl.Parent then
			lbl.Text = ok and tostring(v) or "-"
		end
	end
end

function Stats:_setValue() end

function Stats:Destroy()
	if self._ctx and self._ctx.fps then
		self._ctx.fps:Destroy()
	end
	Element.Destroy(self)
end

function Tab:CreateStats(config)
	return Stats:_create(self._window, self, config or {})
end

----------------------------------------------------------------
-- Tab:Add(type, config) + Tab:CreateMany(list) - data-driven building
----------------------------------------------------------------

Polaris.ElementTypes = {
	Section = function(t, c) return t:CreateSection(c) end,
	Button = function(t, c) return t:CreateButton(c) end,
	Toggle = function(t, c) return t:CreateToggle(c) end,
	Slider = function(t, c) return t:CreateSlider(c) end,
	Dropdown = function(t, c) return t:CreateDropdown(c) end,
	ColorPicker = function(t, c) return t:CreateColorPicker(c) end,
	Keybind = function(t, c) return t:CreateKeybind(c) end,
	Textbox = function(t, c) return t:CreateTextbox(c) end,
	Paragraph = function(t, c) return t:CreateParagraph(c) end,
	Divider = function(t, c) return t:CreateDivider(c) end,
	Label = function(t, c) return t:CreateLabel(c) end,
	Heading = function(t, c) return t:CreateHeading(c.Text or c.Name) end,
	Progress = function(t, c) return t:CreateProgress(c) end,
	Console = function(t, c) return t:CreateConsole(c) end,
	ButtonRow = function(t, c) return t:CreateButtonRow(c) end,
	Stats = function(t, c) return t:CreateStats(c) end,
}

function Tab:Add(kind, config)
	local make = Polaris.ElementTypes[kind]
	assert(make, "[Polaris] Unknown element type '" .. tostring(kind) .. "'. Valid: " .. table.concat((function()
		local k = {}
		for name in Polaris.ElementTypes do
			table.insert(k, name)
		end
		table.sort(k)
		return k
	end)(), ", "))
	return make(self, config or {})
end

function Tab:CreateMany(list)
	local made = {}
	for _, item in ipairs(list) do
		local kind = item.Type or item.Kind
		table.insert(made, self:Add(kind, item))
	end
	return made
end

----------------------------------------------------------------
-- Window helpers
----------------------------------------------------------------

function Window:GetTab(name)
	for _, t in self._tabs do
		if t._name == name then
			return t
		end
	end
	return nil
end

function Window:SelectTab(name)
	local t = type(name) == "string" and self:GetTab(name) or name
	if t then
		self:_selectTab(t)
	end
	return t
end

-- Modal dialog drawn inside the window.
-- config: Title, Content, Buttons = { {Name, Callback, Color}, ... }
function Window:Dialog(config)
	config = config or {}
	local frame = self._frame
	local overlay = Create("TextButton", {
		Name = "DialogOverlay",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 200,
		Parent = frame,
	})
	Create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = overlay })
	local buttons = config.Buttons or { { Name = "OK" } }
	local width = math.min(380, math.max(240, (frame.AbsoluteSize and frame.AbsoluteSize.X or 0) - 40))
	if width < 240 then
		width = 340
	end
	local card = Kit.frame(overlay, {
		Color = "Background", Radius = 10, Stroke = "Accent", ZIndex = 201, Anchor = Vector2.new(0.5, 0.5),
		Size = UDim2.new(0, width, 0, 150), Position = UDim2.new(0.5, 0, 0.5, 0),
	})
	local title = Kit.label(card, config.Title or "Are you sure?", { Size = 17, Bold = true, Position = UDim2.new(0, 16, 0, 12), WidthOffset = -32, Height = 24 })
	title.ZIndex = 202
	local body = Kit.label(card, tostring(config.Content or ""), { Size = 14, Color = "SubText", Wrap = true, Position = UDim2.new(0, 16, 0, 40), WidthOffset = -32, Height = 56, VAlign = "Top" })
	body.ZIndex = 202
	local d = { _gui = overlay }
	function d:Close()
		if overlay.Parent then
			overlay:Destroy()
		end
	end
	local n = #buttons
	for i, def in ipairs(buttons) do
		local btn = Kit.button(card, def.Name or def[1] or "OK", {
			Color = def.Color or (i == n and "Accent" or "Secondary"),
			TextColor = (i ~= n and not def.Color) and "Text" or nil,
			Size = UDim2.new(1 / n, -10, 0, 32),
			Position = UDim2.new((i - 1) / n, 8, 1, -44),
			TextSize = 14,
		})
		btn.ZIndex = 203
		btn.Activated:Connect(function()
			d:Close()
			I.invokeCallback(def.Callback or def[2])
		end)
	end
	return d
end

-- Built-in "Settings" tab: theme picker, config buttons, destroy.
function Window:AddSettingsTab(opts)
	opts = opts or {}
	local tab = self:CreateTab({ Name = opts.Name or "Settings" })
	tab:CreateSection({ Name = "Look" })
	local themes = Polaris:GetThemeNames()
	tab:CreateDropdown({
		Name = "Theme",
		Options = themes,
		Default = Polaris.CurrentThemeName or "Default",
		Callback = function(choice)
			local picked = type(choice) == "table" and choice[1] or choice
			if picked then
				Polaris:SetTheme(picked)
			end
		end,
	})
	if self._config.ConfigFolder and I.FS then
		tab:CreateSection({ Name = "Saved settings" })
		tab:CreateButtonRow({
			Buttons = {
				{ Name = "Save settings", Callback = function() self:SaveConfig() Polaris:Notify({ Title = "Saved", Content = "Your settings were saved.", Type = "success" }) end },
				{ Name = "Load settings", Callback = function() self:LoadConfig() end },
			},
		})
	end
	tab:CreateSection({ Name = "Window" })
	tab:CreateButton({
		Name = "Hide window (press the toggle key to bring it back)",
		Callback = function()
			self:SetVisible(false)
		end,
	})
	tab:CreateButton({
		Name = "Close and remove this UI",
		Callback = function()
			self:Dialog({
				Title = "Close this UI?",
				Content = "The window will be removed. Run the script again to open it.",
				Buttons = { { Name = "Keep it" }, { Name = "Close it", Color = "Danger", Callback = function() self:Destroy() end } },
			})
		end,
	})
	tab:CreateParagraph({ Text = "Polaris " .. Polaris.Version .. (opts.About and ("\n" .. opts.About) or "") })
	return tab
end

end

----------------------------------------------------------------
-- module: 04_library.luau
----------------------------------------------------------------
do
-- library: a data model for collections of scripts + the Script Library widget.
--
--   local lib = Polaris.Library.new({ Name = "My Scripts" })
--   lib:Add({ Name = "Hello", Description = "Says hi", Run = function() print("hi") end })
--   tab:CreateScriptLibrary({ Library = lib })

local Create, safeTween, Element, Tab = I.Create, I.safeTween, I.Element, I.Tab
local Kit, Util = Polaris.Kit, Polaris.Util
local JSON = Util.JSON

local Library = {}
Library.__index = Library
Polaris.Library = Library

local function asList(v)
	if type(v) == "table" then
		return v
	end
	local out = {}
	if type(v) == "string" then
		for part in v:gmatch("[^,]+") do
			local trimmed = part:match("^%s*(.-)%s*$")
			if trimmed ~= "" then
				table.insert(out, trimmed)
			end
		end
	end
	return out
end

local function isUrl(s)
	return type(s) == "string" and s:match("^https?://") ~= nil
end

-- Turn a user-written script definition into a clean entry (or raise a friendly error).
function Library.normalize(def)
	assert(type(def) == "table", "[Polaris] Library: a script must be a table like { Name = \"...\", Url = \"...\" }")
	assert(type(def.Name) == "string" and def.Name ~= "", "[Polaris] Library: every script needs a Name")
	local entry = {
		Name = def.Name,
		Id = def.Id or I.slugify(def.Name),
		Description = tostring(def.Description or def.Desc or ""),
		Author = def.Author and tostring(def.Author) or nil,
		Version = def.Version and tostring(def.Version) or nil,
		Tags = asList(def.Tags),
		Games = asList(def.Games or def.PlaceIds or def.Game),
		Icon = def.Icon,
	}
	local src = def.Source
	local fn = def.Run or def.Callback or (type(src) == "function" and src) or nil
	if type(fn) == "function" then
		entry.Run = fn
	end
	local url = def.Url or def.URL or def.Link or (isUrl(src) and src) or nil
	if isUrl(url) then
		entry.Url = url
	end
	local code = def.Code or ((type(src) == "string" and not isUrl(src)) and src) or nil
	if type(code) == "string" and code ~= "" then
		entry.Code = code
	end
	assert(entry.Run or entry.Url or entry.Code, ("[Polaris] Library: script '%s' needs a Run function, a Url, or Code"):format(def.Name))
	return entry
end

function Library.new(opts)
	opts = opts or {}
	local self = setmetatable({}, Library)
	self.Name = opts.Name or "Scripts"
	self.TrustedHosts = opts.TrustedHosts -- optional allow-list of hosts for Url scripts
	self._scripts = {}
	self._order = {}
	self._fav = {}
	self._runs = {}
	self._events = Util.Events()
	self._folder = opts.Folder and ("Polaris_" .. I.slugify(opts.Folder)) or nil
	self:_load()
	if opts.Scripts then
		self:AddMany(opts.Scripts)
	end
	return self
end

function Library:On(name, fn)
	return self._events:On(name, fn)
end

-- persistence of favourites + run counts (only where the executor offers file access)
function Library:_path()
	if self._folder and I.FS then
		return self._folder .. "/library.json"
	end
	return nil
end

function Library:_load()
	local path = self:_path()
	if not path then
		return
	end
	pcall(function()
		if I.FS.isfile(path) then
			local data = JSON.decode(I.FS.read(path))
			if type(data) == "table" then
				for _, id in ipairs(data.favourites or {}) do
					self._fav[id] = true
				end
				for id, n in pairs(data.runs or {}) do
					self._runs[id] = n
				end
			end
		end
	end)
end

function Library:_save()
	local path = self:_path()
	if not path then
		return
	end
	pcall(function()
		if not I.FS.isfile(self._folder .. "/.keep") then
			pcall(I.FS.mkdir, self._folder)
		end
		local favs = {}
		for id in pairs(self._fav) do
			table.insert(favs, id)
		end
		table.sort(favs)
		I.FS.write(path, JSON.encode({ favourites = favs, runs = self._runs }))
	end)
end

function Library:Add(def)
	local entry = Library.normalize(def)
	if self._scripts[entry.Id] then
		-- replace in place so re-running a script never duplicates cards
		self._scripts[entry.Id] = entry
	else
		self._scripts[entry.Id] = entry
		table.insert(self._order, entry.Id)
	end
	self._events:Emit("change")
	return entry
end

function Library:AddMany(list)
	local added = {}
	for _, def in ipairs(list) do
		table.insert(added, self:Add(def))
	end
	return added
end

function Library:Remove(id)
	if self._scripts[id] then
		self._scripts[id] = nil
		table.remove(self._order, I.indexOf(self._order, id))
		self._events:Emit("change")
		return true
	end
	return false
end

function Library:Get(id)
	return self._scripts[id]
end

function Library:Count()
	return #self._order
end

function Library:IsForThisGame(entry)
	if #entry.Games == 0 then
		return false
	end
	local place, gameId = game.PlaceId, game.GameId
	for _, g in ipairs(entry.Games) do
		local n = tonumber(g)
		if n and (n == place or n == gameId) then
			return true
		end
	end
	return false
end

function Library:Favourite(id, on)
	if on == nil then
		on = not self._fav[id]
	end
	self._fav[id] = on or nil
	self:_save()
	self._events:Emit("change")
	return on
end

function Library:IsFavourite(id)
	return self._fav[id] == true
end

function Library:Tags()
	local seen, out = {}, {}
	for _, id in ipairs(self._order) do
		for _, t in ipairs(self._scripts[id].Tags) do
			local key = t:lower()
			if not seen[key] then
				seen[key] = true
				table.insert(out, t)
			end
		end
	end
	table.sort(out, function(a, b)
		return a:lower() < b:lower()
	end)
	return out
end

-- filter: Text, Tag, Favourites (bool), ThisGame (bool)
function Library:Query(filter)
	filter = filter or {}
	local text = filter.Text and filter.Text:lower() or ""
	local tag = filter.Tag and filter.Tag:lower() or nil
	local out = {}
	for _, id in ipairs(self._order) do
		local e = self._scripts[id]
		local keep = true
		if text ~= "" then
			local hay = (e.Name .. " " .. e.Description .. " " .. (e.Author or "") .. " " .. table.concat(e.Tags, " ")):lower()
			keep = hay:find(text, 1, true) ~= nil
		end
		if keep and tag then
			keep = false
			for _, t in ipairs(e.Tags) do
				if t:lower() == tag then
					keep = true
				end
			end
		end
		if keep and filter.Favourites then
			keep = self._fav[id] == true
		end
		if keep and filter.ThisGame then
			keep = self:IsForThisGame(e)
		end
		if keep then
			table.insert(out, e)
		end
	end
	table.sort(out, function(a, b)
		local ga, gb = self:IsForThisGame(a), self:IsForThisGame(b)
		if ga ~= gb then
			return ga
		end
		local fa, fb = self._fav[a.Id] == true, self._fav[b.Id] == true
		if fa ~= fb then
			return fa
		end
		return a.Name:lower() < b.Name:lower()
	end)
	return out
end

local function hostAllowed(self, url)
	if not self.TrustedHosts or #self.TrustedHosts == 0 then
		return true
	end
	local host = Util.hostOf(url):lower()
	for _, h in ipairs(self.TrustedHosts) do
		if host == h:lower() then
			return true
		end
	end
	return false
end

-- Where would running this script fetch code from? (for confirmation prompts)
function Library:Describe(entry)
	if entry.Run then
		return "a function in this script"
	elseif entry.Code then
		return "code stored in this library"
	end
	return Util.hostOf(entry.Url)
end

function Library:NeedsConfirm(entry)
	return entry.Url ~= nil and entry.Run == nil and entry.Code == nil
end

-- Run a script safely. Returns ok, errorMessage.
function Library:Run(idOrEntry)
	local entry = type(idOrEntry) == "table" and idOrEntry or self._scripts[idOrEntry]
	if not entry then
		return false, "That script is not in the library."
	end
	local ok, err
	if entry.Run then
		ok, err = pcall(entry.Run, entry)
	else
		local code = entry.Code
		if not code then
			if not hostAllowed(self, entry.Url) then
				err = "Blocked: " .. Util.hostOf(entry.Url) .. " is not in this library's TrustedHosts list."
				self._events:Emit("error", entry, err)
				return false, err
			end
			local body, fetchErr = Util.Http.Get(entry.Url)
			if not body then
				err = "Could not download the script (" .. tostring(fetchErr) .. ")."
				self._events:Emit("error", entry, err)
				return false, err
			end
			code = body
		end
		local loader = loadstring
		if type(loader) ~= "function" then
			err = "This place does not allow loadstring, so downloaded scripts cannot run here. Use a Run function instead."
			self._events:Emit("error", entry, err)
			return false, err
		end
		local fn, compileErr = loader(code)
		if not fn then
			err = "The script has a mistake and could not start: " .. tostring(compileErr)
			self._events:Emit("error", entry, err)
			return false, err
		end
		ok, err = pcall(fn)
	end
	if ok then
		self._runs[entry.Id] = (self._runs[entry.Id] or 0) + 1
		self:_save()
		self._events:Emit("run", entry)
		return true
	end
	err = tostring(err)
	self._events:Emit("error", entry, err)
	return false, err
end

-- Add scripts from a manifest: a table, a JSON string, or an https URL to a JSON file.
-- Format: { "scripts": [ { "Name": "...", "Url": "...", "Description": "...", "Tags": ["..."] } ] }
function Library:LoadManifest(source)
	local data = source
	if type(source) == "string" then
		local text = source
		if isUrl(source) then
			local body, err = Util.Http.Get(source)
			if not body then
				return 0, "Could not download the manifest: " .. tostring(err)
			end
			text = body
		end
		local decoded, jerr = JSON.decode(text)
		if not decoded then
			return 0, "The manifest is not valid JSON: " .. tostring(jerr)
		end
		data = decoded
	end
	local list = data.scripts or data
	local added, problems = 0, {}
	for i, def in ipairs(list) do
		local ok, err = pcall(function()
			self:Add(def)
		end)
		if ok then
			added += 1
		else
			table.insert(problems, ("#%d: %s"):format(i, tostring(err):gsub("^.-%[Polaris%] ", "")))
		end
	end
	return added, #problems > 0 and table.concat(problems, "; ") or nil
end

-- JSON text of everything that can be serialised (function-only scripts are skipped)
function Library:Export()
	local out = {}
	for _, id in ipairs(self._order) do
		local e = self._scripts[id]
		if e.Url or e.Code then
			table.insert(out, {
				Name = e.Name, Id = e.Id, Description = e.Description, Author = e.Author, Version = e.Version,
				Tags = e.Tags, Games = e.Games, Url = e.Url, Code = e.Code,
			})
		end
	end
	return JSON.encode({ name = self.Name, scripts = out }, true)
end

----------------------------------------------------------------
-- Widget
----------------------------------------------------------------

local LibEl = setmetatable({}, { __index = Element })
LibEl.__index = LibEl

local function pill(parent, text, active, onClick, width)
	local b = Kit.button(parent, text, {
		Color = active and "Accent" or "Secondary",
		TextColor = (not active) and "SubText" or nil,
		Size = UDim2.new(0, width or (#text * 7 + 22), 0, 24),
		TextSize = 12,
		Radius = 12,
	})
	b.Activated:Connect(onClick)
	return b
end

function LibEl:_create(window, tab, config)
	local self = Element._new(window, tab, config, "ScriptLibrary")
	setmetatable(self, LibEl)

	local lib = config.Library
	if not lib then
		lib = Library.new({ Name = config.Name or "Scripts", Folder = config.Folder, Scripts = config.Scripts, TrustedHosts = config.TrustedHosts })
	end
	if config.Manifest then
		task.spawn(function()
			local n, err = lib:LoadManifest(config.Manifest)
			if err then
				Polaris:Notify({ Title = "Library", Content = err, Type = "warning" })
			end
		end)
	end
	self.Library = lib
	self._filter = { Text = "", Tag = nil, Favourites = false, ThisGame = false }
	self._confirm = config.Confirm == nil and "remote" or config.Confirm

	local height = type(config.Height) == "number" and config.Height or 340
	local row = Create("Frame", { Name = "ScriptLibrary", Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, Parent = tab._content })
	self._container = row
	local holder = Create("Frame", { Name = "Holder", Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, Parent = row })
	self._holder = holder

	-- top bar: search + quick filters
	local bar = Create("Frame", { Name = "Bar", Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, Parent = holder })
	local search = Kit.input(bar, { Placeholder = "Search " .. lib.Name .. "...", Size = UDim2.new(1, -170, 0, 30), TextSize = 14 })
	self._search = search
	local fav = Kit.button(bar, "Favourites", { Color = "Secondary", TextColor = "SubText", Size = UDim2.new(0, 84, 0, 30), Position = UDim2.new(1, -166, 0, 0), TextSize = 12 })
	local here = Kit.button(bar, "This game", { Color = "Secondary", TextColor = "SubText", Size = UDim2.new(0, 78, 0, 30), Position = UDim2.new(1, -78, 0, 0), TextSize = 12 })
	self._favBtn, self._hereBtn = fav, here

	-- tag chips
	self._tags = Create("ScrollingFrame", {
		Name = "Tags", Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0, 36), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X, Parent = holder,
	})
	Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = self._tags })

	self._list = Kit.scroll(holder, { Padding = 6, Size = UDim2.new(1, 0, 1, -94), Position = UDim2.new(0, 0, 0, 68), Name = "Cards" })
	self._status = Kit.label(holder, "", { Size = 12, Color = "SubText", Position = UDim2.new(0, 0, 1, -20), Height = 18 })

	self:_track(search:GetPropertyChangedSignal("Text"):Connect(function()
		self._filter.Text = search.Text
		self._status.Text = ""
		self:Render()
	end))
	self:_track(fav.Activated:Connect(function()
		self._filter.Favourites = not self._filter.Favourites
		self._status.Text = ""
		self:Render()
	end))
	self:_track(here.Activated:Connect(function()
		self._filter.ThisGame = not self._filter.ThisGame
		self._status.Text = ""
		self:Render()
	end))
	self._sub = lib:On("change", function()
		if not self._destroyed then
			self:Render()
		end
	end)

	if config.Height == nil or config.Height == "Fill" then
		Polaris._bindFill(self, 240, 8)
	end
	self._value = ""
	self:Render()
	return self
end

function LibEl:_runEntry(entry)
	local lib = self.Library
	local function go()
		self._status.Text = "Running " .. entry.Name .. "..."
		local ok, err = lib:Run(entry)
		if self._destroyed then
			return
		end
		if ok then
			self._status.Text = "Ran " .. entry.Name .. " successfully."
			Polaris:Notify({ Title = entry.Name, Content = "Started.", Type = "success", Duration = 2.5 })
		else
			self._status.Text = "Problem with " .. entry.Name
			Polaris:Notify({ Title = entry.Name .. " did not start", Content = tostring(err), Type = "error", Duration = 6 })
		end
		if self._config.OnRun then
			I.invokeCallback(self._config.OnRun, entry, ok, err)
		end
		self:Render()
	end
	local needs = self._confirm == true or (self._confirm == "remote" and lib:NeedsConfirm(entry))
	if needs then
		self._window:Dialog({
			Title = "Run " .. entry.Name .. "?",
			Content = "This will download code from " .. lib:Describe(entry) .. " and run it on your device. Only continue if you trust it.",
			Buttons = { { Name = "Cancel" }, { Name = "Run it", Callback = go } },
		})
	else
		go()
	end
end

function LibEl:_card(entry)
	local lib = self.Library
	local forHere = lib:IsForThisGame(entry)
	local card = Kit.frame(self._list, { Color = "Secondary", Radius = 8, Stroke = forHere and "Accent" or true, Size = UDim2.new(1, -4, 0, 72), Name = "Card" })
	card.LayoutOrder = 0
	local icon = Kit.frame(card, { Color = entry.IconColor or Kit.colorFor(entry.Name), Radius = 8, Size = UDim2.new(0, 44, 0, 44), Position = UDim2.new(0, 10, 0, 14) })
	local glyph = type(entry.Icon) == "string" and not entry.Icon:match("^rbxassetid") and entry.Icon:sub(1, 2) or entry.Name:sub(1, 1):upper()
	local g = Kit.label(icon, glyph, { Size = 22, Bold = true, Align = "Center", Height = 44, Color = Color3.fromRGB(20, 20, 28) })
	if type(entry.Icon) == "string" and entry.Icon:match("^rbxassetid") then
		g.Text = ""
		Create("ImageLabel", { Size = UDim2.new(1, -8, 1, -8), Position = UDim2.new(0, 4, 0, 4), BackgroundTransparency = 1, Image = entry.Icon, Parent = icon })
	end
	local title = entry.Name .. (entry.Version and ("  v" .. entry.Version) or "")
	Kit.label(card, title, { Size = 15, Bold = true, Position = UDim2.new(0, 64, 0, 8), Width = 1, WidthOffset = -64 - 128, Height = 20, Truncate = true })
	Kit.label(card, entry.Description ~= "" and entry.Description or "No description yet.", {
		Size = 12, Color = "SubText", Position = UDim2.new(0, 64, 0, 28), Width = 1, WidthOffset = -64 - 128, Height = 16, Truncate = true,
	})
	local meta = {}
	if forHere then
		table.insert(meta, "FOR THIS GAME")
	end
	if entry.Author then
		table.insert(meta, "by " .. entry.Author)
	end
	if #entry.Tags > 0 then
		table.insert(meta, table.concat(entry.Tags, ", "))
	end
	local runs = lib._runs[entry.Id]
	if runs and runs > 0 then
		table.insert(meta, "ran " .. runs .. "x")
	end
	Kit.label(card, table.concat(meta, "  \u{2022}  "), { Size = 11, Color = forHere and "Accent" or "SubText", Position = UDim2.new(0, 64, 0, 46), Width = 1, WidthOffset = -64 - 128, Height = 16, Truncate = true })

	local isFav = lib:IsFavourite(entry.Id)
	local star = Kit.button(card, isFav and "\u{2605}" or "\u{2606}", {
		Color = "Primary", TextColor = isFav and "Warning" or "SubText", Size = UDim2.new(0, 36, 0, 36), Position = UDim2.new(1, -122, 0, 18), TextSize = 18, Radius = 18,
	})
	star.Activated:Connect(function()
		lib:Favourite(entry.Id)
	end)
	local run = Kit.button(card, "Run", { Color = "Accent", Size = UDim2.new(0, 70, 0, 36), Position = UDim2.new(1, -80, 0, 18), TextSize = 14 })
	run.Activated:Connect(function()
		self:_runEntry(entry)
	end)
	return card
end

function LibEl:Render()
	if self._destroyed or not self._list then
		return
	end
	local lib, f = self.Library, self._filter
	-- tag chips
	Kit.clear(self._tags)
	local tags = lib:Tags()
	self._tags.Visible = #tags > 0
	if #tags > 0 then
		local all = pill(self._tags, "All", f.Tag == nil, function()
			f.Tag = nil
			self._status.Text = ""
			self:Render()
		end, 44)
		all.LayoutOrder = 0
		for i, t in ipairs(tags) do
			local p = pill(self._tags, t, f.Tag ~= nil and f.Tag:lower() == t:lower(), function()
				f.Tag = (f.Tag ~= nil and f.Tag:lower() == t:lower()) and nil or t
				self._status.Text = ""
				self:Render()
			end)
			p.LayoutOrder = i
		end
		self._list.Position = UDim2.new(0, 0, 0, 68)
		self._list.Size = UDim2.new(1, 0, 1, -94)
	else
		self._list.Position = UDim2.new(0, 0, 0, 38)
		self._list.Size = UDim2.new(1, 0, 1, -62)
	end
	Kit.paint(self._favBtn, "BackgroundColor3", f.Favourites and "Accent" or "Secondary")
	self._favBtn.TextColor3 = f.Favourites and Color3.new(1, 1, 1) or Kit.theme().SubText
	Kit.paint(self._hereBtn, "BackgroundColor3", f.ThisGame and "Accent" or "Secondary")
	self._hereBtn.TextColor3 = f.ThisGame and Color3.new(1, 1, 1) or Kit.theme().SubText

	-- cards
	Kit.clear(self._list)
	local results = lib:Query(f)
	for i, entry in ipairs(results) do
		local c = self:_card(entry)
		c.LayoutOrder = i
	end
	if #results == 0 then
		local hint = lib:Count() == 0 and "This library is empty. Add scripts with library:Add({ Name = ..., Url = ... })."
			or "Nothing matches. Clear the search or the filters."
		local l = Kit.label(self._list, hint, { Size = 14, Color = "SubText", Align = "Center", Wrap = true, Height = 60, Name = "Empty" })
		l.LayoutOrder = 1
	end
	local favCount = 0
	for _ in pairs(lib._fav) do
		favCount += 1
	end
	if not self._status.Text:match("^Ran ") and not self._status.Text:match("^Problem") and not self._status.Text:match("^Running") then
		self._status.Text = ("%d of %d scripts  \u{2022}  %d favourites"):format(#results, lib:Count(), favCount)
	end
end

function LibEl:_setValue(v)
	if type(v) == "string" and self._search then
		self._search.Text = v
	end
end

function LibEl:Destroy()
	if self._sub then
		self._sub.Disconnect()
	end
	Element.Destroy(self)
end

function Tab:CreateScriptLibrary(config)
	if config and getmetatable(config) == Library then
		config = { Library = config }
	elseif type(config) == "table" and #config > 0 and config.Name == nil then
		config = { Scripts = config }
	end
	return LibEl:_create(self._window, self, config or {})
end
Polaris.ElementTypes.ScriptLibrary = function(t, c) return t:CreateScriptLibrary(c) end

end

----------------------------------------------------------------
-- module: 05_research.luau
----------------------------------------------------------------
do
-- research: a "deep research" engine (plan -> steps -> sources -> cited report)
-- with pluggable providers, plus the Research Panel widget.
--
--   local session = Polaris.Research.new({ Provider = "Demo" })
--   session:On("done", function(state) print(state.Report) end)
--   session:Run("How do ocean tides work?", { Depth = "Standard" })

local Create, Element, Tab = I.Create, I.Element, I.Tab
local Kit, Util = Polaris.Kit, Polaris.Util
local JSON, Markdown, Http = Util.JSON, Util.Markdown, Util.Http

local Research = {}
Research.__index = Research
Polaris.Research = Research

Research.Depths = {
	Quick = { Name = "Quick", Effort = "fast", Timeout = 120 },
	Standard = { Name = "Standard", Effort = "medium", Timeout = 420 },
	Deep = { Name = "Deep", Effort = "high", Timeout = 900 },
	Max = { Name = "Max", Effort = "xhigh", Timeout = 1800 },
}
Research.DepthOrder = { "Quick", "Standard", "Deep" }

Research.Providers = {}

----------------------------------------------------------------
-- Session
----------------------------------------------------------------

local function blankState()
	return { Status = "idle", Query = "", Depth = "Standard", Plan = {}, Sources = {}, Report = "", Error = nil, Log = {} }
end

function Research.resolve(spec)
	if spec == nil then
		spec = "Demo"
	end
	if type(spec) == "string" then
		local make = Research.Providers[spec]
		assert(make, ("[Polaris] Research: unknown provider '%s'. Built in: Demo, Perplexity, HTTP"):format(spec))
		return make({})
	elseif type(spec) == "function" then
		return { Name = "Custom", Run = function(_, ctx)
			return spec(ctx)
		end }
	elseif type(spec) == "table" and type(spec.Run) == "function" then
		return spec
	end
	error("[Polaris] Research: Provider must be a name, a function(ctx), or a table with a Run method", 0)
end

function Research.new(opts)
	opts = opts or {}
	local self = setmetatable({}, Research)
	self.Provider = Research.resolve(opts.Provider)
	self.State = blankState()
	self.Depth = opts.Depth or "Standard"
	self._events = Util.Events()
	self._token = 0
	return self
end

function Research:On(name, fn)
	return self._events:On(name, fn)
end

function Research:SetProvider(spec)
	self.Provider = Research.resolve(spec)
	self._events:Emit("provider", self.Provider)
end

function Research:IsRunning()
	return self.State.Status == "running"
end

function Research:Cancel()
	if self:IsRunning() then
		self._token += 1
		self.State.Status = "cancelled"
		for _, step in ipairs(self.State.Plan) do
			if step.Status == "running" then
				step.Status = "pending"
			end
		end
		self._events:Emit("status", self.State)
		self._events:Emit("cancelled", self.State)
	end
end

function Research:Reset()
	self._token += 1
	self.State = blankState()
	self._events:Emit("reset", self.State)
end

local function makeContext(self, token, query, depthName)
	local state = self.State
	local ev = self._events
	local ctx = { Query = query, Depth = depthName, DepthInfo = Research.Depths[depthName] or Research.Depths.Standard }
	local function live()
		return self._token == token
	end
	function ctx:IsCancelled()
		return not live()
	end
	function ctx:Wait(seconds)
		local t = 0
		while t < seconds do
			if not live() then
				return false
			end
			local dt = math.min(0.1, seconds - t)
			task.wait(dt)
			t += dt
		end
		return live()
	end
	function ctx:SetPlan(titles)
		if not live() then return end
		state.Plan = {}
		for _, t in ipairs(titles) do
			table.insert(state.Plan, { Title = t, Status = "pending" })
		end
		ev:Emit("plan", state.Plan)
	end
	function ctx:AddStep(title)
		if not live() then return end
		table.insert(state.Plan, { Title = title, Status = "pending" })
		ev:Emit("plan", state.Plan)
		return #state.Plan
	end
	function ctx:Step(i, status, note)
		if not live() or not state.Plan[i] then return end
		state.Plan[i].Status = status or "running"
		if note ~= nil then
			state.Plan[i].Note = note
		end
		ev:Emit("step", i, state.Plan[i])
	end
	function ctx:Source(src)
		if not live() or type(src) ~= "table" then return end
		local url = src.Url or src.url
		for i, s in ipairs(state.Sources) do
			if url and s.Url == url then
				return i
			end
		end
		table.insert(state.Sources, {
			Title = tostring(src.Title or src.title or Util.hostOf(url or "") or "Source"),
			Url = url,
			Snippet = src.Snippet or src.snippet,
			Host = Util.hostOf(url or ""),
		})
		ev:Emit("source", state.Sources[#state.Sources], #state.Sources)
		return #state.Sources
	end
	function ctx:Text(chunk)
		if not live() then return end
		state.Report ..= tostring(chunk)
		ev:Emit("text", state.Report, tostring(chunk))
	end
	function ctx:SetText(full)
		if not live() then return end
		state.Report = tostring(full)
		ev:Emit("text", state.Report, state.Report)
	end
	function ctx:Log(msg)
		if not live() then return end
		table.insert(state.Log, tostring(msg))
		ev:Emit("log", tostring(msg))
	end
	function ctx:Done()
		if not live() or state.Status ~= "running" then return end
		for _, step in ipairs(state.Plan) do
			if step.Status ~= "failed" then
				step.Status = "done"
			end
		end
		state.Status = "done"
		ev:Emit("plan", state.Plan)
		ev:Emit("status", state)
		ev:Emit("done", state)
	end
	function ctx:Fail(message)
		if not live() or state.Status ~= "running" then return end
		state.Status = "error"
		state.Error = tostring(message)
		for _, step in ipairs(state.Plan) do
			if step.Status == "running" then
				step.Status = "failed"
			end
		end
		ev:Emit("plan", state.Plan)
		ev:Emit("status", state)
		ev:Emit("error", state.Error)
	end
	return ctx
end

function Research:Run(query, opts)
	opts = opts or {}
	query = tostring(query or ""):match("^%s*(.-)%s*$")
	if query == "" then
		self._events:Emit("error", "Type a question first.")
		return false, "Type a question first."
	end
	if self:IsRunning() then
		self:Cancel()
	end
	local depthName = opts.Depth or self.Depth
	if not Research.Depths[depthName] then
		depthName = "Standard"
	end
	self._token += 1
	local token = self._token
	self.State = blankState()
	self.State.Status = "running"
	self.State.Query = query
	self.State.Depth = depthName
	self.State.StartedAt = os.clock()
	self._events:Emit("reset", self.State)
	self._events:Emit("status", self.State)
	local ctx = makeContext(self, token, query, depthName)
	task.spawn(function()
		local ok, err = pcall(function()
			return self.Provider:Run(ctx)
		end)
		if not ok then
			ctx:Fail("The research provider crashed: " .. tostring(err))
		elseif self._token == token and self.State.Status == "running" and not self.Provider.Async then
			ctx:Done()
		end
	end)
	return true
end

function Research:GetReport()
	return self.State.Report
end

-- Report + numbered source list as plain Markdown (for copy / save)
function Research:ExportMarkdown()
	local s = self.State
	local out = { "# " .. (s.Query ~= "" and s.Query or "Research"), "", s.Report }
	if #s.Sources > 0 then
		table.insert(out, "")
		table.insert(out, "## Sources")
		for i, src in ipairs(s.Sources) do
			table.insert(out, ("%d. %s%s"):format(i, src.Title, src.Url and (" - " .. src.Url) or ""))
		end
	end
	return table.concat(out, "\n")
end

----------------------------------------------------------------
-- Providers
----------------------------------------------------------------

-- Demo: runs offline, no key, no internet.  Output is clearly marked as a demo.
Research.Providers.Demo = function(opts)
	opts = opts or {}
	local speed = opts.Speed or 1
	return {
		Name = "Demo",
		Run = function(_, ctx)
			local steps = {
				"Understand the question",
				"Plan the search",
				"Find sources",
				"Read and compare sources",
				"Check the facts",
				"Write the report",
			}
			if ctx.Depth == "Quick" then
				steps = { "Understand the question", "Find sources", "Write the answer" }
			end
			ctx:SetPlan(steps)
			for i, title in ipairs(steps) do
				ctx:Step(i, "running")
				if not ctx:Wait(0.5 / speed) then return end
				if title == "Find sources" then
					for n = 1, (ctx.Depth == "Quick" and 2 or (ctx.Depth == "Deep" and 6 or 4)) do
						ctx:Source({ Title = "Demo source " .. n .. " (not a real page)", Url = "https://example.com/demo-source-" .. n, Snippet = "Placeholder text." })
						if not ctx:Wait(0.2 / speed) then return end
					end
				end
				ctx:Step(i, "done")
			end
			local words = {}
			for word in ctx.Query:gmatch("%S+") do
				table.insert(words, word)
			end
			ctx:SetText(table.concat({
				"# Demo report: " .. ctx.Query,
				"",
				"> This is **demo output**. Nothing was searched and nothing below is a real fact about your question.",
				"",
				"## What a real report looks like",
				"- A short answer first, then the evidence [1].",
				"- Every claim points at a numbered source [2][3].",
				"- Disagreements between sources are called out instead of hidden.",
				"",
				"## How to get real answers",
				"1. Pick a provider: `Provider = \"Perplexity\"` (needs your own API key) or `Provider = \"HTTP\"` (your own server).",
				"2. Or write one: `Provider = function(ctx) ... end` and call `ctx:Text(...)`.",
				"3. See GUIDE.md, chapter \"Deep research UI\".",
				"",
				("Depth used: **%s**. Question length: %d words."):format(ctx.Depth, #words),
			}, "\n"))
		end,
	}
end

-- Perplexity Agent API (https://docs.perplexity.ai).  You must supply your own API key.
-- Needs an HTTP-capable environment (an executor's request(), or HttpService on a server).
Research.Providers.Perplexity = function(opts)
	opts = opts or {}
	local provider = { Name = "Perplexity", NeedsKey = true, Async = true }
	local key = opts.ApiKey
	function provider:SetKey(k)
		key = k
	end
	function provider:HasKey()
		return type(key) == "string" and #key > 8
	end
	local base = opts.BaseUrl or "https://api.perplexity.ai"

	local function headers()
		return { ["Authorization"] = "Bearer " .. tostring(key), ["Content-Type"] = "application/json" }
	end

	local function explain(res)
		local status = res.StatusCode
		if status == 401 or status == 403 then
			return "Perplexity rejected the API key. Check that it is correct and has credit."
		elseif status == 429 then
			return "Too many requests or out of quota (HTTP 429). Wait a bit and try again."
		elseif status == 0 then
			return "Could not reach Perplexity: " .. tostring(res.Error) .. ". This place may block HTTP requests."
		end
		return "Perplexity returned an error: " .. tostring(res.Error) .. " " .. tostring(res.Body):sub(1, 160)
	end

	-- Pull text + sources out of an Agent API response (tolerant of shape differences)
	function provider.parse(resp)
		local text, sources = {}, {}
		if type(resp.output) == "table" then
			for _, item in ipairs(resp.output) do
				if item.type == "message" then
					for _, part in ipairs(item.content or {}) do
						if part.type == "output_text" and part.text then
							table.insert(text, part.text)
							for _, a in ipairs(part.annotations or {}) do
								if a.url then
									table.insert(sources, { Title = a.title, Url = a.url })
								end
							end
						end
					end
				elseif item.type == "search_results" then
					for _, r in ipairs(item.results or {}) do
						table.insert(sources, { Title = r.title, Url = r.url, Snippet = r.snippet })
					end
				end
			end
		end
		if #text == 0 and type(resp.output_text) == "string" then
			table.insert(text, resp.output_text)
		end
		for _, c in ipairs(resp.citations or {}) do
			if type(c) == "string" then
				table.insert(sources, { Url = c })
			elseif type(c) == "table" then
				table.insert(sources, { Title = c.title, Url = c.url })
			end
		end
		return table.concat(text, "\n"), sources
	end

	function provider:Run(ctx)
		if not self:HasKey() then
			return ctx:Fail("Paste your Perplexity API key first (it is only kept in memory).")
		end
		if not Http.Available() then
			return ctx:Fail("This place cannot make HTTP requests, so it cannot reach Perplexity. Use an executor with request() or a server script with HttpService enabled.")
		end
		ctx:SetPlan({ "Send the question", "Research (the agent searches and reads)", "Collect the sources", "Show the report" })
		ctx:Step(1, "running")
		local body = {
			effort = opts.Effort or ctx.DepthInfo.Effort,
			input = ctx.Query,
			background = true,
		}
		if opts.Instructions then
			body.instructions = opts.Instructions
		end
		local res = Http.Request({ Url = base .. "/v1/agent", Method = "POST", Headers = headers(), Body = body })
		if ctx:IsCancelled() then return end
		if not res.Success then
			return ctx:Fail(explain(res))
		end
		local resp = JSON.decode(res.Body)
		if type(resp) ~= "table" then
			return ctx:Fail("Perplexity sent back something that is not JSON.")
		end
		ctx:Step(1, "done")
		ctx:Step(2, "running")
		local started = os.clock()
		local timeout = opts.Timeout or ctx.DepthInfo.Timeout
		local terminal = { completed = true, failed = true, cancelled = true, incomplete = true }
		while resp.status and not terminal[resp.status] do
			if os.clock() - started > timeout then
				return ctx:Fail("Timed out after " .. timeout .. " seconds. Try a lighter depth.")
			end
			if not ctx:Wait(opts.PollEvery or 3) then return end
			ctx:Step(2, "running", ("%s, %ds"):format(tostring(resp.status), math.floor(os.clock() - started)))
			local poll = Http.Request({ Url = base .. "/v1/agent/" .. tostring(resp.id), Method = "GET", Headers = headers() })
			if ctx:IsCancelled() then return end
			if not poll.Success then
				return ctx:Fail(explain(poll))
			end
			resp = JSON.decode(poll.Body) or resp
		end
		if resp.status == "failed" then
			local msg = type(resp.error) == "table" and (resp.error.message or JSON.encode(resp.error)) or tostring(resp.error)
			return ctx:Fail("The research run failed: " .. msg)
		elseif resp.status == "cancelled" then
			return ctx:Fail("The research run was cancelled.")
		end
		ctx:Step(2, "done")
		ctx:Step(3, "running")
		local text, sources = provider.parse(resp)
		for _, s in ipairs(sources) do
			ctx:Source(s)
		end
		ctx:Step(3, "done")
		ctx:Step(4, "running")
		if text == "" then
			return ctx:Fail("The run finished but returned no text.")
		end
		if resp.status == "incomplete" then
			text ..= "\n\n> The run stopped before finishing, so this report may be incomplete."
		end
		ctx:SetText(text)
		ctx:Step(4, "done")
		ctx:Done()
	end
	return provider
end

-- Generic HTTP provider: POST { query, depth } to your own endpoint.
-- Expected JSON reply: { "report": "markdown", "sources": [ { "title": "", "url": "" } ] }
-- Keeping the real API key on your own server is the safest setup.
Research.Providers.HTTP = function(opts)
	opts = opts or {}
	assert(type(opts.Url) == "string", "[Polaris] Research HTTP provider needs Url = \"https://...\"")
	return {
		Name = "HTTP",
		Async = true,
		Run = function(_, ctx)
			if not Http.Available() then
				return ctx:Fail("This place cannot make HTTP requests.")
			end
			ctx:SetPlan({ "Ask the server", "Show the report" })
			ctx:Step(1, "running")
			local payload = opts.BuildBody and opts.BuildBody(ctx) or { query = ctx.Query, depth = ctx.Depth, effort = ctx.DepthInfo.Effort }
			local res = Http.Request({ Url = opts.Url, Method = opts.Method or "POST", Headers = opts.Headers, Body = payload })
			if ctx:IsCancelled() then return end
			if not res.Success then
				return ctx:Fail("The server answered with an error: " .. tostring(res.Error))
			end
			local text, sources
			if opts.Parse then
				text, sources = opts.Parse(res.Body)
			else
				local data = JSON.decode(res.Body)
				if type(data) ~= "table" then
					text, sources = res.Body, {}
				else
					text = data.report or data.answer or data.text or data.output_text or ""
					sources = data.sources or data.citations or {}
				end
			end
			for _, s in ipairs(sources or {}) do
				ctx:Source(type(s) == "string" and { Url = s } or s)
			end
			ctx:Step(1, "done")
			ctx:Step(2, "running")
			ctx:SetText(text or "")
			ctx:Step(2, "done")
			ctx:Done()
		end,
	}
end

----------------------------------------------------------------
-- Widget: Tab:CreateResearch
----------------------------------------------------------------

local ResEl = setmetatable({}, { __index = Element })
ResEl.__index = ResEl

local STEP_GLYPH = { pending = "\u{25CB}", running = "\u{25D4}", done = "\u{2713}", failed = "\u{2715}" }
local STEP_COLOR = { pending = "SubText", running = "Accent", done = "Success", failed = "Danger" }

function ResEl:_create(window, tab, config)
	local self = Element._new(window, tab, config, "Research")
	setmetatable(self, ResEl)

	local session = config.Session or Research.new({ Provider = config.Provider, Depth = config.Depth })
	self.Session = session
	self._depths = config.Depths or Research.DepthOrder
	self._depth = config.Depth or "Standard"
	session.Depth = self._depth

	local height = type(config.Height) == "number" and config.Height or 380
	local row = Create("Frame", { Name = "Research", Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, Parent = tab._content })
	self._container = row
	local holder = Create("Frame", { Name = "Holder", Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, Parent = row })

	-- ask row
	local ask = Kit.input(holder, { Placeholder = config.Placeholder or "Ask anything...", Size = UDim2.new(1, -104, 0, 34), TextSize = 15, Name = "Question" })
	self._ask = ask
	self._go = Kit.button(holder, "Research", { Color = "Accent", Size = UDim2.new(0, 98, 0, 34), Position = UDim2.new(1, -98, 0, 0), TextSize = 14 })

	-- depth + status row
	local meta = Create("Frame", { Name = "Meta", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0, 40), BackgroundTransparency = 1, Parent = holder })
	Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = meta })
	self._depthButtons = {}
	for i, d in ipairs(self._depths) do
		local b = Kit.button(meta, d, { Color = "Secondary", TextColor = "SubText", Size = UDim2.new(0, #d * 8 + 24, 0, 24), TextSize = 12, Radius = 12 })
		b.LayoutOrder = i
		b.Activated:Connect(function()
			self:SetDepth(d)
		end)
		self._depthButtons[d] = b
	end
	self._statusLbl = Kit.label(meta, "", { Size = 12, Color = "SubText", Width = 0, WidthOffset = 260, Height = 24, Truncate = true })
	self._statusLbl.LayoutOrder = 99

	-- key row (only for providers that need a key)
	local keyTop = 70
	self._keyRow = Create("Frame", { Name = "KeyRow", Size = UDim2.new(1, 0, 0, 32), Position = UDim2.new(0, 0, 0, keyTop), BackgroundTransparency = 1, Visible = false, Parent = holder })
	self._keyBox = Kit.input(self._keyRow, { Placeholder = "Paste your API key (kept in memory only)", Size = UDim2.new(1, 0, 0, 30), TextSize = 13, Name = "Key" })

	-- body
	self._body, self._bodyLayout = Kit.scroll(holder, { Padding = 8, Size = UDim2.new(1, 0, 1, -72), Position = UDim2.new(0, 0, 0, 70), Name = "Body" })
	self._planBox = Create("Frame", { Name = "Plan", Size = UDim2.new(1, -4, 0, 0), BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = self._body })
	Create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = self._planBox })
	self._report = Kit.label(self._body, "", { Size = config.TextSize or 15, Wrap = true, Rich = true, Auto = true, VAlign = "Top", Height = 10, Width = 1, WidthOffset = -4, Name = "Report" })
	self._report.LayoutOrder = 2
	self._srcBox = Create("Frame", { Name = "Sources", Size = UDim2.new(1, -4, 0, 0), BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = self._body })
	Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = self._srcBox })
	self._actions = Create("Frame", { Name = "Actions", Size = UDim2.new(1, -4, 0, 32), BackgroundTransparency = 1, LayoutOrder = 4, Visible = false, Parent = self._body })

	local copy = Kit.button(self._actions, "Copy report", { Color = "Secondary", TextColor = "Text", Size = UDim2.new(0.5, -4, 0, 30), TextSize = 13 })
	local save = Kit.button(self._actions, "Save to file", { Color = "Secondary", TextColor = "Text", Size = UDim2.new(0.5, -4, 0, 30), Position = UDim2.new(0.5, 4, 0, 0), TextSize = 13 })
	self:_track(copy.Activated:Connect(function()
		self:Copy()
	end))
	self:_track(save.Activated:Connect(function()
		self:Save()
	end))

	-- wiring
	self:_track(self._go.Activated:Connect(function()
		if session:IsRunning() then
			session:Cancel()
		else
			self:Start()
		end
	end))
	self:_track(ask.FocusLost:Connect(function(enter)
		if enter and not session:IsRunning() then
			self:Start()
		end
	end))
	self:_track(self._keyBox.FocusLost:Connect(function()
		local text = self._keyBox.Text
		if text ~= "" and text:gsub("\u{2022}", "") ~= "" then
			if session.Provider.SetKey then
				session.Provider:SetKey(text)
			end
			self._keyBox.Text = string.rep("\u{2022}", math.min(#text, 24))
		end
	end))
	local subs = {
		session:On("reset", function() self:_renderAll() end),
		session:On("plan", function() self:_renderPlan() end),
		session:On("step", function() self:_renderPlan() end),
		session:On("source", function() self:_renderSources() end),
		session:On("text", function(full) self:_renderReport(full) end),
		session:On("status", function() self:_renderStatus() end),
		session:On("error", function(msg)
			if session.State.Status ~= "error" then
				Polaris:Notify({ Title = "Research", Content = tostring(msg), Type = "warning", Duration = 4 })
			end
			self:_renderStatus()
		end),
		session:On("provider", function() self:_renderStatus() end),
	}
	self._subs = subs

	if config.ApiKey and session.Provider.SetKey then
		session.Provider:SetKey(config.ApiKey)
	end
	if config.Height == nil or config.Height == "Fill" then
		Polaris._bindFill(self, 260, 8)
	end
	self._value = ""
	self:SetDepth(self._depth)
	self:_renderAll()
	return self
end

function ResEl:SetDepth(d)
	if not Research.Depths[d] then
		return
	end
	self._depth = d
	self.Session.Depth = d
	for name, b in pairs(self._depthButtons) do
		Kit.paint(b, "BackgroundColor3", name == d and "Accent" or "Secondary")
		if name == d then
			b.TextColor3 = Color3.new(1, 1, 1)
		else
			Kit.paint(b, "TextColor3", "SubText")
		end
	end
end

function ResEl:Start(query)
	if query then
		self._ask.Text = query
	end
	local prov = self.Session.Provider
	if prov.NeedsKey and prov.HasKey and not prov:HasKey() then
		self._keyRow.Visible = true
		self:_layoutBody()
		Polaris:Notify({ Title = "API key needed", Content = "Paste your key in the box, then press Research again.", Type = "warning", Duration = 4 })
		return false
	end
	return self.Session:Run(self._ask.Text, { Depth = self._depth })
end

function ResEl:_layoutBody()
	local keyShown = self._keyRow.Visible
	local top = keyShown and 106 or 70
	self._body.Position = UDim2.new(0, 0, 0, top)
	self._body.Size = UDim2.new(1, 0, 1, -(top + 2))
end

function ResEl:_renderStatus()
	if self._destroyed then return end
	local s = self.Session.State
	local prov = self.Session.Provider
	local label = ({
		idle = "Ready", running = "Researching...", done = "Done", error = "Problem", cancelled = "Stopped",
	})[s.Status] or s.Status
	local text = prov.Name .. "  \u{2022}  " .. label
	if s.Status == "error" and s.Error then
		text = s.Error
	end
	self._statusLbl.Text = text
	Kit.paint(self._statusLbl, "TextColor3", s.Status == "error" and "Danger" or (s.Status == "done" and "Success" or "SubText"))
	self._go.Text = s.Status == "running" and "Stop" or "Research"
	Kit.paint(self._go, "BackgroundColor3", s.Status == "running" and "Danger" or "Accent")
	self._keyRow.Visible = (prov.NeedsKey == true) and not (prov.HasKey and prov:HasKey())
	self:_layoutBody()
	self._actions.Visible = s.Status == "done" and s.Report ~= ""
end

function ResEl:_renderPlan()
	if self._destroyed then return end
	Kit.clear(self._planBox)
	for i, step in ipairs(self.Session.State.Plan) do
		local line = Kit.label(self._planBox, ("%s  %s%s"):format(STEP_GLYPH[step.Status] or "?", step.Title, step.Note and ("  (" .. step.Note .. ")") or ""), {
			Size = 13, Color = STEP_COLOR[step.Status] or "SubText", Height = 18, Name = "Step",
		})
		line.LayoutOrder = i
	end
end

function ResEl:_renderReport(full)
	if self._destroyed then return end
	local theme = Kit.theme()
	self._report.Text = Markdown.toRichText(full or "", { Accent = Util.hex(theme.Accent), BaseSize = self._config.TextSize or 15 })
end

function ResEl:_renderSources()
	if self._destroyed then return end
	Kit.clear(self._srcBox)
	local sources = self.Session.State.Sources
	if #sources == 0 then
		return
	end
	local head = Kit.label(self._srcBox, "Sources (" .. #sources .. ")", { Size = 14, Bold = true, Height = 22, Name = "Head" })
	head.LayoutOrder = 0
	for i, src in ipairs(sources) do
		local b = Kit.button(self._srcBox, ("[%d]  %s%s"):format(i, src.Title, src.Host ~= "" and ("  \u{2022}  " .. src.Host) or ""), {
			Color = "Secondary", TextColor = "Text", Size = UDim2.new(1, 0, 0, 30), TextSize = 12, Bold = false,
		})
		b.TextXAlignment = Enum.TextXAlignment.Left
		b.TextTruncate = Enum.TextTruncate.AtEnd
		Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = b })
		b.LayoutOrder = i
		b.Activated:Connect(function()
			if src.Url and I.copyText(src.Url) then
				Polaris:Notify({ Title = "Link copied", Content = src.Url, Type = "success", Duration = 2.5 })
			else
				Polaris:Notify({ Title = src.Title, Content = tostring(src.Url or "No link"), Duration = 5 })
			end
		end)
	end
end

function ResEl:_renderAll()
	self:_renderPlan()
	self:_renderReport(self.Session.State.Report)
	self:_renderSources()
	self:_renderStatus()
end

function ResEl:Copy()
	local md = self.Session:ExportMarkdown()
	if I.copyText(md) then
		Polaris:Notify({ Title = "Copied", Content = "The report is on your clipboard.", Type = "success", Duration = 2.5 })
	else
		Polaris:Notify({ Title = "Cannot copy here", Content = "This place has no clipboard. Use Save to file, or print the report from your script.", Type = "warning", Duration = 4 })
	end
end

function ResEl:Save()
	local name = "research_" .. I.slugify(self.Session.State.Query):sub(1, 30) .. ".md"
	if I.saveFile and I.saveFile(name, self.Session:ExportMarkdown()) then
		Polaris:Notify({ Title = "Saved", Content = "Saved as " .. name .. " in your executor's workspace folder.", Type = "success", Duration = 4 })
	else
		Polaris:Notify({ Title = "Cannot save here", Content = "This place cannot write files. Use Copy report instead.", Type = "warning", Duration = 4 })
	end
end

function ResEl:_setValue(v)
	if type(v) == "string" then
		self._ask.Text = v
	end
end

function ResEl:Destroy()
	if self._subs then
		for _, s in ipairs(self._subs) do
			s.Disconnect()
		end
	end
	if self.Session and self.Session:IsRunning() then
		self.Session:Cancel()
	end
	Element.Destroy(self)
end

function Tab:CreateResearch(config)
	if type(config) == "string" then
		config = { Provider = config }
	end
	return ResEl:_create(self._window, self, config or {})
end
Polaris.ElementTypes.Research = function(t, c) return t:CreateResearch(c) end

end

----------------------------------------------------------------
-- module: 06_easy.luau
----------------------------------------------------------------
do
-- easy: the "anyone can use it" layer.
--   Polaris.Hub{...}            describe a UI with plain tables, get a working window
--   Polaris.Templates.*         ready-made UIs (ScriptLibrary, DeepResearch, RobloxHub, Everything)
--   Polaris.Make("words")       say what you want, get a matching UI
--   Polaris.FromProject(table)  open a project exported from the Builder

local Create, Window = I.Create, I.Window
local Kit, Util = Polaris.Kit, Polaris.Util

local Easy = {}
Polaris.Easy = Easy
Polaris.Templates = {}
local Templates = Polaris.Templates

----------------------------------------------------------------
-- helpers
----------------------------------------------------------------

local uid = 0
local function uniqueName(base)
	uid += 1
	return uid == 1 and base or (base .. " " .. uid)
end

-- iterate a "name -> value" dictionary (sorted) or an ordered list of { name, value }
local function eachNamed(group)
	local list = {}
	if type(group) ~= "table" then
		return list
	end
	if #group > 0 then
		for _, pair in ipairs(group) do
			if type(pair) == "table" then
				table.insert(list, { pair.Name or pair[1], pair.Value or pair[2] or pair })
			end
		end
	else
		local keys = {}
		for k in pairs(group) do
			table.insert(keys, tostring(k))
		end
		table.sort(keys)
		for _, k in ipairs(keys) do
			table.insert(list, { k, group[k] })
		end
	end
	return list
end

local function asCfg(value, key)
	if type(value) == "table" then
		return value
	elseif type(value) == "function" then
		return { Callback = value }
	elseif value ~= nil then
		return { [key or "Default"] = value }
	end
	return {}
end

-- Convert a friendly group ({ Buttons=, Toggles=, Sliders=, Dropdowns=, Inputs=, Text= }) into element configs.
local function groupItems(group)
	local items = {}
	local function add(kind, name, cfg)
		cfg = table.clone(cfg)
		cfg.Type = kind
		cfg.Name = name
		table.insert(items, cfg)
	end
	for _, t in ipairs(type(group.Text) == "table" and group.Text or (group.Text and { group.Text } or {})) do
		table.insert(items, { Type = "Label", Text = t })
	end
	for _, p in ipairs(eachNamed(group.Buttons)) do
		add("Button", p[1], asCfg(p[2]))
	end
	for _, p in ipairs(eachNamed(group.Toggles)) do
		add("Toggle", p[1], asCfg(p[2], "Default"))
	end
	for _, p in ipairs(eachNamed(group.Sliders)) do
		local cfg = asCfg(p[2])
		cfg.Min, cfg.Max = cfg.Min or 0, cfg.Max or 100
		cfg.Default = cfg.Default or cfg.Min
		add("Slider", p[1], cfg)
	end
	for _, p in ipairs(eachNamed(group.Dropdowns)) do
		add("Dropdown", p[1], asCfg(p[2], "Options"))
	end
	for _, p in ipairs(eachNamed(group.Inputs)) do
		add("Textbox", p[1], asCfg(p[2], "Default"))
	end
	for _, p in ipairs(eachNamed(group.Keybinds)) do
		add("Keybind", p[1], asCfg(p[2], "Default"))
	end
	if type(group.Items) == "table" then
		for _, it in ipairs(group.Items) do
			table.insert(items, it)
		end
	end
	return items
end
Easy.groupItems = groupItems

local function keyCodeOf(v)
	if type(v) == "string" then
		return Enum.KeyCode[v]
	end
	return v
end

local function addAll(tab, items)
	for _, it in ipairs(items) do
		local cfg = it
		if it.Type == "Keybind" and type(it.Default) == "string" then
			cfg = table.clone(it)
			cfg.Default = keyCodeOf(it.Default)
		end
		tab:Add(it.Type or it.Kind, cfg)
	end
end
Easy.addAll = addAll

-- Floating round button that shows/hides a window (phones and tablets have no keyboard toggle key).
function Easy.floatingToggle(window, opts)
	opts = opts or {}
	local uis = I.services.UserInputService
	local gui = Create("ScreenGui", { Name = "PolarisToggle", ResetOnSpawn = false, IgnoreGuiInset = true, Parent = I.getGuiParent() })
	local btn = Kit.button(gui, opts.Text or "P", {
		Color = "Accent", Size = UDim2.new(0, 46, 0, 46), Position = opts.Position or UDim2.new(0, 14, 0.5, -23), TextSize = 20, Radius = 23,
	})
	btn.Active = true
	local dragging, startPos, startInput, moved = false, nil, nil, false
	btn.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging, moved = true, false
			startPos, startInput = btn.Position, input.Position
		end
	end)
	uis.InputChanged:Connect(function(input)
		if dragging and startInput and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - startInput
			if math.abs(delta.X) + math.abs(delta.Y) > 6 then
				moved = true
			end
			if moved then
				btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end
	end)
	uis.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	btn.Activated:Connect(function()
		if not moved then
			window:SetVisible(not window:GetVisible())
		end
	end)
	window._extras = window._extras or {}
	table.insert(window._extras, gui)
	return gui
end

local origDestroy = Window.Destroy
function Window:Destroy()
	if self._extras then
		for _, g in ipairs(self._extras) do
			pcall(function()
				g:Destroy()
			end)
		end
		self._extras = nil
	end
	return origDestroy(self)
end

-- Window with friendly defaults (screen-aware size, key to hide it, floating button on touch devices)
function Easy.Window(opts)
	opts = opts or {}
	local size = opts.Size
	if type(size) == "table" then
		size = Vector2.new(size[1] or size.X or 640, size[2] or size.Y or 440)
	end
	size = Kit.fitSize(size and size.X or 660, size and size.Y or 450)
	local name = opts.Name or "Polaris"
	local theme = opts.Theme
	if theme and not Polaris.Themes[theme] then
		warn("[Polaris] Unknown theme '" .. tostring(theme) .. "', using Default. Themes: " .. table.concat(Polaris:GetThemeNames(), ", "))
		theme = nil
	end
	local window = Polaris:CreateWindow({
		Name = name,
		Theme = theme or "Default",
		Size = size,
		ToggleKey = opts.ToggleKey == nil and Enum.KeyCode.RightShift or keyCodeOf(opts.ToggleKey),
		ConfigFolder = opts.ConfigFolder or I.slugify(name),
		SaveConfig = opts.SaveConfig == true,
		Position = opts.Position,
	})
	if opts.FloatingButton == true or (opts.FloatingButton == nil and Kit.isTouch()) then
		Easy.floatingToggle(window)
	end
	return window
end

----------------------------------------------------------------
-- Polaris.Hub / Polaris:Build  - plain tables in, working window out
----------------------------------------------------------------

-- spec: Name, Theme, Size, ToggleKey, Tabs, Buttons/Toggles/Sliders/... (go to a "Main" tab),
--       Scripts / Library (adds a Scripts tab), Research (adds a Research tab), Settings (default true)
function Easy.Hub(spec)
	spec = spec or {}
	local window = spec.Window or Easy.Window(spec)
	local made = { Window = window, Tabs = {} }

	local main = groupItems(spec)
	local tabSpecs = {}
	if #main > 0 then
		table.insert(tabSpecs, { Name = spec.MainTab or "Main", Group = spec })
	end
	for _, p in ipairs(eachNamed(spec.Tabs)) do
		local group = p[2]
		table.insert(tabSpecs, { Name = (type(group) == "table" and group.Name) or p[1], Group = group })
	end
	for _, ts in ipairs(tabSpecs) do
		local tab = window:CreateTab({ Name = ts.Name })
		addAll(tab, groupItems(ts.Group))
		made.Tabs[ts.Name] = tab
	end

	local libSource = spec.Library or spec.Scripts
	if libSource then
		local tab = window:CreateTab({ Name = spec.ScriptsTab or "Scripts" })
		local cfg = { Height = "Fill" }
		if getmetatable(libSource) == Polaris.Library then
			cfg.Library = libSource
		else
			cfg.Scripts = libSource
		end
		cfg.Manifest = spec.Manifest
		cfg.TrustedHosts = spec.TrustedHosts
		made.Library = tab:CreateScriptLibrary(cfg).Library
		made.Tabs.Scripts = tab
	elseif spec.Manifest then
		local tab = window:CreateTab({ Name = "Scripts" })
		made.Library = tab:CreateScriptLibrary({ Manifest = spec.Manifest, Height = "Fill", TrustedHosts = spec.TrustedHosts }).Library
		made.Tabs.Scripts = tab
	end

	if spec.Research then
		local tab = window:CreateTab({ Name = spec.ResearchTab or "Research" })
		local rc = type(spec.Research) == "table" and table.clone(spec.Research) or { Provider = spec.Research == true and "Demo" or spec.Research }
		rc.Height = rc.Height or "Fill"
		made.Research = tab:CreateResearch(rc)
		made.Tabs.Research = tab
	end

	if spec.Settings ~= false then
		made.Tabs.Settings = window:AddSettingsTab()
	end
	if not window._welcomed and spec.Welcome ~= false then
		window._welcomed = true
		Polaris:Notify({ Title = spec.Name or "Polaris", Content = "Ready. Press " .. (window._toggleKey and window._toggleKey.Name or "the button") .. " to hide or show.", Type = "success", Duration = 4 })
	end
	return window, made
end
Polaris.Hub = Easy.Hub

function Polaris:Build(spec)
	return Easy.Hub(spec)
end

-- Quick one-liner:  Polaris.Quick("My UI", { "Say hi", function() print("hi") end }, ...)
function Polaris.Quick(title, ...)
	local buttons = {}
	for _, pair in ipairs({ ... }) do
		table.insert(buttons, { pair[1], pair[2] })
	end
	return Easy.Hub({ Name = title, Buttons = buttons })
end

----------------------------------------------------------------
-- Builder projects -> live windows
----------------------------------------------------------------

local function nodeToItem(node, handlers)
	local k = node.Kind
	local h = handlers and handlers[node.Name]
	local flag = (node.Flag and node.Flag ~= "") and node.Flag or nil
	if k == "Section" then
		return { Type = "Section", Name = node.Name }
	elseif k == "Button" then
		return { Type = "Button", Name = node.Name, Callback = h }
	elseif k == "Toggle" then
		return { Type = "Toggle", Name = node.Name, Default = node.Default == true, Flag = flag, Callback = h }
	elseif k == "Slider" then
		return { Type = "Slider", Name = node.Name, Min = tonumber(node.Min) or 0, Max = tonumber(node.Max) or 100, Default = tonumber(node.Default) or 0, Increment = tonumber(node.Increment) or 1, ValueName = node.ValueName ~= "" and node.ValueName or nil, Flag = flag, Callback = h }
	elseif k == "Dropdown" then
		return { Type = "Dropdown", Name = node.Name, Options = I.splitOptions(node.Options), Multiple = node.Multiple == true, Flag = flag, Callback = h }
	elseif k == "ColorPicker" then
		return { Type = "ColorPicker", Name = node.Name, Default = Color3.fromRGB(tonumber(node.R) or 0, tonumber(node.G) or 0, tonumber(node.B) or 0), Flag = flag, Callback = h }
	elseif k == "Keybind" then
		return { Type = "Keybind", Name = node.Name, Default = Enum.KeyCode[node.Key or "RightControl"], Hold = node.Hold == true, Flag = flag, Callback = h }
	elseif k == "Textbox" then
		return { Type = "Textbox", Name = node.Name, Default = node.Default or "", TextDisappear = node.TextDisappear == true, Flag = flag, Callback = h }
	elseif k == "Paragraph" then
		return { Type = "Paragraph", Text = node.Text }
	elseif k == "Divider" then
		return { Type = "Divider" }
	end
	local K = I.Builder.Kinds[k]
	if K and K.item then
		return K.item(node, handlers)
	end
	return nil
end
Easy.nodeToItem = nodeToItem

-- project: the table from Builder:GetProject() or Builder:ExportJSON() text.
-- handlers: optional { ["Element name"] = function(...) end } to wire up callbacks.
function Polaris.FromProject(project, handlers)
	if type(project) == "string" then
		local data, err = Util.JSON.decode(project)
		assert(data, "[Polaris] FromProject: not valid JSON (" .. tostring(err) .. ")")
		project = data
	end
	assert(type(project) == "table" and type(project.window) == "table" and type(project.tabs) == "table", "[Polaris] FromProject: expected a Builder project with window and tabs")
	local w = project.window
	local window = Easy.Window({ Name = w.Name, Theme = w.Theme, ConfigFolder = w.ConfigFolder, SaveConfig = w.SaveConfig, ToggleKey = w.ToggleKey })
	for _, t in ipairs(project.tabs) do
		local tab = window:CreateTab({ Name = t.Name, Icon = (t.Icon and t.Icon ~= "") and t.Icon or nil })
		for _, node in ipairs(t.nodes or {}) do
			local item = nodeToItem(node, handlers)
			if item then
				tab:Add(item.Type, item)
			end
		end
	end
	return window
end

