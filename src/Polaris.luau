local function clipboardAvailable()
	return type(setclipboard) == "function"
end

local function copyText(text)
	local ok = pcall(function()
		setclipboard(text)
	end)
	return ok
end

local function saveFile(path, content)
	if not FS then
		return false
	end
	local ok = pcall(function()
		FS.mkdir("PolarisBuilder")
		FS.write(path, content)
	end)
	return ok
